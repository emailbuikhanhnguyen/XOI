rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Điểm bán / bếp trung tâm — chỉ chủ quán được thêm/sửa/xoá
    match /locations/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Hồ sơ người dùng (tên, vai trò, điểm bán được gán)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin();
    }

    // Chấm công hàng ngày (gắn theo điểm bán). Nhân viên chỉ tạo/sửa/xoá
    // phiếu của chính mình; chủ quán được tạo/sửa/xoá phiếu của bất kỳ nhân
    // viên nào (vd. chấm công hộ, sửa số liệu nhập nhầm, xoá phiếu trùng).
    match /entries/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Nhập nguyên liệu vào kho (thường là bếp trung tâm)
    match /ingredients/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Chuyển hàng từ bếp trung tâm ra điểm bán
    match /transfers/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Thu & chi khác ngoài lương/nguyên liệu (mặt bằng, điện nước, sửa chữa...) — chỉ chủ quán quản lý
    match /thuchi/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Quyết toán lương theo tuần (chỉ chủ quán chỉnh)
    match /settlements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Cài đặt chung / dự phòng (giá bán, lương mặc định...)
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Định mức nguyên liệu/phần (BOM) + ngưỡng cảnh báo tồn kho — chỉ chủ quán chỉnh
    match /itemCatalog/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Yêu cầu/đặt hàng nguyên liệu từ điểm bán gửi bếp trung tâm. Điểm bán
    // tạo đơn của mình; ai đã đăng nhập cũng cập nhật được trạng thái (để
    // nhân viên bếp đánh dấu đã xử lý mà không cần là chủ tài khoản); chỉ
    // chủ quán hoặc người tạo mới xoá được.
    match /orders/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
